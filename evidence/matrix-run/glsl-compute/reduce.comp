#version 450

// Parallel reduction: sum of a float array
// local_size_x = 256, tree reduction with barriers
// Partial sums written to per-workgroup output buffer
// Non-multiple-of-workgroup sizes handled via bounds check + zero padding

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputBuffer {
    float data[];
};

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    float partialSums[];
};

// Push constants carry the true element count so we can guard OOB reads
layout(push_constant) uniform PushConstants {
    uint elementCount;
} pc;

// Shared memory tile — one slot per invocation in the workgroup
shared float tile[256];

void main() {
    uint lid   = gl_LocalInvocationID.x;   // 0..255
    uint gid   = gl_GlobalInvocationID.x;  // global element index
    uint group = gl_WorkGroupID.x;          // which workgroup we are

    // Load from global memory, zero-pad if out of bounds
    tile[lid] = (gid < pc.elementCount) ? data[gid] : 0.0;

    // Wait for every lane in the workgroup to finish writing to shared memory
    barrier();
    memoryBarrierShared();

    // Tree reduction: each step halves the active lane count
    // stride starts at 128, then 64, 32, 16, 8, 4, 2, 1
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lid < stride) {
            tile[lid] += tile[lid + stride];
        }
        barrier();
        memoryBarrierShared();
    }

    // Lane 0 writes the workgroup partial sum to the output buffer
    if (lid == 0u) {
        partialSums[group] = tile[0];
    }
}
